# Base URL of the FastAPI (or other) backend, without a trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api

# When true, all service calls are served by an in-memory mock backend
# (src/services/mock.ts) instead of hitting VITE_API_BASE_URL. Useful for
# building and testing the UI before a real backend exists.
VITE_USE_MOCK_API=true
