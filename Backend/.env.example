APP_NAME=Campaign Studio API
APP_ENV=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=sqlite:///./campaign_studio.db
FRONTEND_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
PUBLIC_BASE_URL=http://localhost:8000

# When set, every API request (except /api/health) must send this value in an
# X-Access-Code header. Leave blank for local dev (no gate).
ACCESS_CODE=

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2

RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4_turbo
RUNWAY_VIDEO_DURATION_SECONDS=5
RUNWAY_VIDEO_RATIO=720:1280

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_LOCAL_STORAGE=true

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/instagram/callback
INSTAGRAM_API_VERSION=v21.0
INSTAGRAM_DEMO_MODE=true

USE_MOCK_PROVIDERS=true

FFMPEG_BINARY=ffmpeg
